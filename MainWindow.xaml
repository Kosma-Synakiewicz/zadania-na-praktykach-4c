<Window x:Class="desktop_gui_zegar_analogowy_i_cyfrowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui_zegar_analogowy_i_cyfrowy"
        mc:Ignorable="d"
        Title="Zegar Analogowy i Cyfrowy" Height="360" Width="550" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Canvas Grid.Column="0" Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Ellipse Width="240" Height="240" Stroke="Black" StrokeThickness="4" Fill="#FDFDFD"/>
            <Ellipse Width="10" Height="10" Fill="Black" Canvas.Left="115" Canvas.Top="115" Panel.ZIndex="10"/>

            <Line x:Name="WskazowkaGodzinowa" X1="120" Y1="120" X2="120" Y2="65" Stroke="Black" StrokeThickness="6" StrokeEndLineCap="Round">
                <Line.RenderTransform>
                    <RotateTransform x:Name="ObrotGodziny" CenterX="120" CenterY="120"/>
                </Line.RenderTransform>
            </Line>

            <Line x:Name="WskazowkaMinutowa" X1="120" Y1="120" X2="120" Y2="40" Stroke="Black" StrokeThickness="4" StrokeEndLineCap="Round">
                <Line.RenderTransform>
                    <RotateTransform x:Name="ObrotMinuty" CenterX="120" CenterY="120"/>
                </Line.RenderTransform>
            </Line>

            <Line x:Name="WskazowkaSekundowa" X1="120" Y1="120" X2="120" Y2="30" Stroke="Red" StrokeThickness="2" StrokeEndLineCap="Round">
                <Line.RenderTransform>
                    <RotateTransform x:Name="ObrotSekundy" CenterX="120" CenterY="120"/>
                </Line.RenderTransform>
            </Line>
        </Canvas>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="AKTUALNY CZAS" FontSize="14" Foreground="#666666" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Background="#1E1E1E" CornerRadius="8" Padding="15,10">
                <TextBlock x:Name="TextBlockCyfrowy" Text="00:00:00" FontFamily="Consolas" FontSize="36" Foreground="DarkRed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TextBlockData" Text="01 stycznia 2026" FontSize="14" Foreground="#333333" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>